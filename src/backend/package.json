{
    "name": "chat-backend",
    "version": "0.1.0",
    "description": "Real-time chat backend with Express, MySQL, JWT, and Socket.IO",
    "main": "dist/server.js",
    "scripts": {
        "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
        "build": "tsc",
        "start": "node dist/server.js"
    },
    "dependencies": {
        "bcrypt": "^5.1.1",
        "cors": "^2.8.5",
        "dotenv": "^16.5.0",
        "express": "^4.18.2",
        "jsonwebtoken": "^9.0.0",
        "mysql2": "^3.1.0",
        "socket.io": "^4.6.1"
    },
    "devDependencies": {
        "@types/bcrypt": "^5.0.2",
        "@types/express": "^4.17.14",
        "@types/jsonwebtoken": "^9.0.1",
        "@types/node": "^18.11.9",
        "ts-node": "^10.9.1",
        "ts-node-dev": "^2.0.0",
        "typescript": "^4.9.5"
    }
}
